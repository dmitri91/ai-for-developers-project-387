{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md", ".opencode/language.ru.md"],
  "permission": {
    "bash": {
      "*": "allow",
      "npx *": "ask",
      "npm install *": "ask",
      "npm i *": "ask",
      "npm ci *": "ask",
      "yarn add *": "ask",
      "pnpm add *": "ask",
      "curl *": "ask",
      "wget *": "ask",
      "git clone *": "ask",
      "pip install *": "ask",
      "python -m pip install *": "ask",
      "docker pull *": "ask",
      "go get *": "ask"
    }
  }
}